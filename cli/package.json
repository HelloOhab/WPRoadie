{
  "name": "wproadie",
  "version": "0.1.0",
  "description": "One MCP connection for all your WPRoadie WordPress sites: a site registry plus a routing MCP server for Claude Code, Claude Desktop and Cursor.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "bin": {
    "wproadie": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node --test --test-concurrency=1 build-test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "wordpress",
    "mcp",
    "wproadie",
    "claude",
    "ai"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^14.0.3",
    "zod": "^4.6.6"
  },
  "optionalDependencies": {
    "@napi-rs/keyring": "^2.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "~6.0.3"
  }
}
